package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "km3_specific_sources",
    srcs: [
        "BaseSEProvider/src/com/android/javacard/keymaster/KM3Applet.java",
    ],
}

filegroup {
    name: "km4_specific_sources",
    srcs: [
        "BaseSEProvider/src/com/android/javacard/keymaster/KM4Applet.java",
    ],
}

filegroup {
    name: "keymint3_applet_sources",
    srcs: [
        "src/**/*.java",
        "BaseSEProviderLib/**/*.java",
        "BaseSEProvider/**/*.java",
        "JCardSimProvider/**/*.java",
        "JCardSimProviderLib/**/*.java",
    ],
    exclude_srcs: [
        ":km4_specific_sources",
    ],
    visibility: ["//visibility:public"],
}

filegroup {
    name: "keymint4_applet_sources",
    srcs: [
        "src/**/*.java",
        "BaseSEProviderLib/**/*.java",
        "BaseSEProvider/**/*.java",
        "JCardSimProvider/**/*.java",
        "JCardSimProviderLib/**/*.java",
    ],
    exclude_srcs: [
        ":km3_specific_sources",
    ],
    visibility: ["//visibility:public"],
}
