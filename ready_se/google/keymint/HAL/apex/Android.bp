prebuilt_etc {
    name: "android.hardware.security.keymint3-apex-service.strongbox.rc",
    vendor: true,
    src: "android.hardware.security.keymint3-apex-service.strongbox.rc",
}

// The following APEX module is introduced specifically for Cuttlefish Virtual devices.
// Converting the HAL binary to an APEX module enables dynamic selection of the HAL
// service at the boot time. For example, the reference StrongBox KeyMint HAL has been
// modularized as an APEX. When the Cuttlefish device is launched with the flag
// --enable_jcard_simulator=true, the CVD will activate the reference Strongbox HAL
// during boot, allowing flexible HAL configuration without rebuilding the system image.
apex {
    name: "com.android.hardware.strongbox",
    manifest: "apex_manifest.json",
    file_contexts: "apex_file_contexts",
    key: "com.google.cf.apex.key",
    certificate: ":com.google.cf.apex.certificate",
    vendor: true,
    updatable: false,
    soc_specific: true,

    binaries: [
        "android.hardware.security.keymint3-service.strongbox",
    ],
    prebuilts: [
        "android.hardware.hardware_keystore.jc-strongbox-keymint3.xml",
        "android.hardware.security.keymint3-apex-service.strongbox.rc",
        "android.hardware.security.keymint3-service.strongbox.xml",
        "android.hardware.security.sharedsecret-service.strongbox3.xml",
    ],
}
